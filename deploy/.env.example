GEO_ADMIN_USERNAME=admin
# Set a generated password of at least 12 characters before starting.
GEO_ADMIN_PASSWORD=
GEO_PUBLIC_URL=https://monitor.example.com
GEO_COOKIE_SECURE=true
GEO_BIND_ADDRESS=127.0.0.1
GEO_PORT=8000
# HTTP direct access: use the real server IP and port in GEO_PUBLIC_URL,
# set GEO_COOKIE_SECURE=false and GEO_BIND_ADDRESS=0.0.0.0. No certificate required.
# HTTP sends credentials, sessions and uploaded source records without encryption.
